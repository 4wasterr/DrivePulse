# Set these in Vercel's backend environment; never add them to frontend VITE_ vars.
NODE_ENV=production
ALLOW_AGENT_SIGNUP=false

# Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Copy the exact URL, replace the password, and percent-encode reserved characters.
# This must start with postgresql://, not the HTTPS Supabase project/API URL.
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL=postgresql://postgres.lncbwboayzawftlnphsg:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Additional public domains, comma-separated HTTPS origins without trailing slashes.
# Vercel deployment/branch/production URLs are detected from system variables.
FRONTEND_ORIGIN=

# Optional: Supabase's downloaded CA certificate, as PEM text (\n escapes allowed).
# Alternatively, use DATABASE_CA_PATH for a local PEM file when running CLI commands.
DATABASE_CA_CERT=

# Resend API credentials for client email verification and password recovery.
RESEND_API=
RESEND_FROM="DrivePulse <onboarding@resend.dev>"
RESEND_REPLY_TO=reizenoh24@gmail.com
