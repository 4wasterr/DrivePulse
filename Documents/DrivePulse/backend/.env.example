# Local development: no Supabase connection is needed.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=data/drivepulse.sqlite
# Empty DATABASE_URL selects SQLite in development only.
DATABASE_URL=
# Leave blank to allow the standard localhost development origins.
FRONTEND_ORIGIN=
# Keep staff registration disabled. Demo accounts are available in development.
ALLOW_AGENT_SIGNUP=false
# Gmail SMTP for account verification and password recovery.
# See docs/email-setup.md. No purchased domain is needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=""
# A Google App Password; never use your regular Google password.
SMTP_PASS=""
# Optional; defaults to DrivePulse <SMTP_USER> and SMTP_USER respectively.
SMTP_FROM=""
SMTP_REPLY_TO=""
